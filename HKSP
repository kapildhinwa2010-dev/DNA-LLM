# 3️⃣ HKSP-BASED MODEL
# ============================================================

class HKSPModel(nn.Module):
    """Model using HyperKnowledge Super Parameters"""
    def __init__(self, in_dim, out_dim, num_domains=4):
        super().__init__()
        self.in_dim = in_dim
        self.out_dim = out_dim
        
        # One super parameter replaces the weight matrix
        self.hksp = HyperKnowledgeSuperParameter(num_domains=num_domains)
        
        # Bias is still normal (small)
        self.bias = nn.Parameter(torch.zeros(out_dim))
    
    def forward(self, x, domain_idx=0):
        # Generate weights on-the-fly
        weight = self.hksp.generate_matrix(self.out_dim, self.in_dim, domain_idx)
        return x @ weight.T + self.bias
    
    def count_parameters(self):
        return sum(p.numel() for p in self.parameters())



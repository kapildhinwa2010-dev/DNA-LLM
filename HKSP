class HyperKnowledgeSuperParameter(nn.Module):
    """
    Ek Super Parameter jo structure (HSP) + knowledge (KSP) dono store karta hai.
    """
    def __init__(self, num_domains=4, embed_dim=64, num_freqs=32, hidden_dim=128):

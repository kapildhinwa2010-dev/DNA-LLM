# 🧬 HYPERKNOWLEDGE SUPER PARAMETER (HKSP)
# Combines Hypernetwork (HSP) + Knowledge (KSP) in one unit
# ============================================================

import torch
import torch.nn as nn
import torch.nn.functional as F
import numpy as np
import matplotlib.pyplot as plt
import os

class HyperKnowledgeSuperParameter(nn.Module):
    """
    Ek Super Parameter jo:
    1. Coordinates (i, j) se structure generate karta hai (HSP style)
    2. Domain context se knowledge inject karta hai (KSP style)
    
    Result: W[i,j] = f(coordinates, domain)
    
    Memory: ~50KB per super parameter
    Output: Can generate infinite matrices with domain-specific knowledge
    """
    
    def __init__(self, num_domains=4, embed_dim=64, num_freqs=32, hidden_dim=128):
        super().__init__()
        
        self.num_domains = num_domains
        self.embed_dim = embed_dim
        self.num_freqs = num_freqs
        self.hidden_dim = hidden_dim
        
        # ===== HSP PART: Coordinate Processing =====
        # Fourier projection for (i, j) coordinates
        self.register_buffer('B', torch.randn(num_freqs, 2) * 20.0)
        coord_features = num_freqs * 2  # sin + cos
        
        # ===== KSP PART: Domain Knowledge Storage =====
        # Learnable embeddings for each domain
        self.domain_embeddings = nn.Embedding(num_domains, embed_dim)
        
        # Domain names for reference
        self.domain_names = ['general', 'math', 'code', 'science']
        
        # ===== HYBRID: Hypernetwork that combines both =====
        # Input: coord_features + embed_dim
        # Output: 1 weight value
        input_dim = coord_features + embed_dim
        
        self.hypernetwork = nn.Sequential(
            nn.Linear(input_dim, hidden_dim),
            nn.SiLU(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.SiLU(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.SiLU(),
            nn.Linear(hidden_dim, 1)
        )
        
        # Global scale parameter (Xavier-like init)
        self.scale = nn.Parameter(torch.tensor(0.01))
    
    def get_fourier_features(self, coords):
        """
        Coordinates ko Fourier features mein convert karta hai.
        
        Args:
            coords: (N, 2) tensor of (i, j) coordinates in [-1, 1]
        
        Returns:
            features: (N, 2*num_freqs) tensor
        """
        # Fourier projection
        proj = 2 * np.pi * coords @ self.B.T
        
        # Concatenate sin and cos
        features = torch.cat([torch.sin(proj), torch.cos(proj)], dim=-1)
        return features
    
    def generate_single_weight(self, i, j, domain_idx):
        """
        Single weight value generate karta hai position (i,j) ke liye.
        
        Args:
            i: Row index in [-1, 1]
            j: Column index in [-1, 1]
            domain_idx: Domain index (0=general, 1=math, 2=code, 3=science)
        
        Returns:
            weight: Single scalar value
        """
        device = self.B.device
        
        # Create coordinate
        coords = torch.tensor([[i, j]], device=device, dtype=torch.float32)
        
        # Get Fourier features (HSP part)
        coord_feats = self.get_fourier_features(coords)  # (1, 2*num_freqs)
        
        # Get domain embedding (KSP part)
        domain_emb = self.domain_embeddings(torch.tensor([domain_idx], device=device))  # (1, embed_dim)
        
        # Combine features
        combined = torch.cat([coord_feats, domain_emb], dim=-1)  # (1, coord_feats + embed_dim)
        
        # Generate weight via hypernetwork
        weight = self.hypernetwork(combined)  # (1, 1)
        
        # Apply scale
        weight = weight * self.scale
        
        return weight.squeeze()
    
    def generate_matrix(self, out_dim, in_dim, domain_idx=0):
        """
        Complete weight matrix generate karta hai.
        
        Args:
            out_dim: Output dimension
            in_dim: Input dimension
            domain_idx: Domain (0=general, 1=math, 2=code, 3=science)
        
        Returns:
            matrix: (out_dim, in_dim) weight matrix
        """
        device = self.B.device
        
        # Create coordinate grid
        i_vals = torch.linspace(-1, 1, out_dim, device=device)
        j_vals = torch.linspace(-1, 1, in_dim, device=device)
        grid_i, grid_j = torch.meshgrid(i_vals, j_vals, indexing='ij')
        
        # Flatten coordinates
        coords = torch.stack([grid_i.flatten(), grid_j.flatten()], dim=1)  # (out_dim*in_dim, 2)
        
        # Get Fourier features for all coordinates (HSP part)
        coord_feats = self.get_fourier_features(coords)  # (N, 2*num_freqs)
        
        # Get domain embedding (KSP part) - same for all coordinates
        domain_emb = self.domain_embeddings(torch.tensor([domain_idx], device=device))  # (1, embed_dim)
        domain_emb = domain_emb.expand(coords.size(0), -1)  # (N, embed_dim)
        
        # Combine features
        combined = torch.cat([coord_feats, domain_emb], dim=-1)  # (N, total_features)
        
        # Generate all weights at once (batched)
        weights = self.hypernetwork(combined)  # (N, 1)
        weights = weights.view(out_dim, in_dim)  # (out_dim, in_dim)
        
        # Apply Xavier-like scaling
        scale_factor = (2.0 / (in_dim + out_dim)) ** 0.5
        weights = weights * self.scale * scale_factor
        
        return weights
    
    def generate_all_domains(self, out_dim, in_dim):
        """
        Saare domains ke liye matrices generate karta hai.
        
        Returns:
            dict: {domain_name: matrix}
        """
        matrices = {}
        for idx, name in enumerate(self.domain_names):
            matrices[name] = self.generate_matrix(out_dim, in_dim, domain_idx=idx)
        return matrices
    
    def count_parameters(self):
        """Total trainable parameters count karta hai"""
        return sum(p.numel() for p in self.parameters())
    
    def calculate_expansion_ratio(self, out_dim, in_dim):
        """
        Ek super parameter se kitne actual weights generate hote hain.
        """
        generated_weights = out_dim * in_dim
        super_param_size = self.count_parameters()
        return generated_weights / super_param_size



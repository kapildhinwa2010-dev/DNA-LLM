def save_hksp(hksp, path='saved_models/hksp.pt'):
    """HKSP ko save karta hai"""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    
    torch.save({
        'state_dict': hksp.state_dict(),
        'config': {
            'num_domains': hksp.num_domains,
            'embed_dim': hksp.embed_dim,
            'num_freqs': hksp.num_freqs,
            'hidden_dim': hksp.hidden_dim,
            'domain_names': hksp.domain_names
        },
        'metadata': {
            'total_params': hksp.count_parameters(),
            'memory_kb': hksp.count_parameters() * 4 / 1024
        }
    }, path)
    
    print(f"✅ HKSP saved to: {path}")


def load_hksp(path='saved_models/hksp.pt'):
    """HKSP ko load karta hai"""
    checkpoint = torch.load(path)
    
    hksp = HyperKnowledgeSuperParameter(
        num_domains=checkpoint['config']['num_domains'],
        embed_dim=checkpoint['config']['embed_dim'],
        num_freqs=checkpoint['config']['num_freqs'],
        hidden_dim=checkpoint['config']['hidden_dim']
    )
    
    hksp.load_state_dict(checkpoint['state_dict'])
    hksp.domain_names = checkpoint['config']['domain_names']
    
    print(f"✅ HKSP loaded from: {path}")
    return hksp


